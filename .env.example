# Managed MySQL/MariaDB database (e.g. Aiven, Railway, external MySQL provider)
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_SSL=true

# Set a random secret of at least 32 characters for signing admin sessions
ADMIN_SESSION_SECRET=

# Canonical Vercel domain; used for PayU callbacks
NEXT_PUBLIC_SITE_URL=https://your-store.vercel.app

# Optional: use PayU test URL while testing; production defaults to secure.payu.in
PAYU_PAYMENT_URL=https://secure.payu.in/_payment

# Vercel Blob token; needed for image uploads from admin panel
BLOB_READ_WRITE_TOKEN=
